---
import AmberRule from '../ui/AmberRule.astro';
import { flowHref, FLOW_COPY } from '../flow/copy';

// 2026-08-15 Flow redirect: the closing band now hands off to the Flow
// waitlist. It previously carried a WaitlistForm switched off behind a
// showEmailCTA flag, waiting on "the relay for the cross-website demand-gen
// form" — that relay resolved the other way. Capture lives on orionfold.com
// (the edge function's CORS allowlist is that origin only), so this band links
// out rather than re-enabling a form that would fail on submit.
// See _SPECS/flow-traffic-redirect-v1.md §3b.
const flowLandingHref = flowHref('cta-footer');
---
<section class="py-32 px-6" data-flow-bridge data-surface="cta-footer">
  <div id="waitlist" class="scroll-mt-32">
    <AmberRule />
  </div>

  <div class="max-w-3xl mx-auto text-center">
    <p data-animate class="font-mono text-xs tracking-widest text-text-muted uppercase mb-6">
      Orionfold Flow · In development
    </p>

    <h2 data-animate class="mb-6" style="transition-delay: 80ms">{FLOW_COPY.title}</h2>

    <p data-animate class="text-text-muted mb-8 max-w-xl mx-auto" style="transition-delay: 160ms">
      The same discipline Arena brings to scoring local models, brought to the document itself.
      Every AI change is a diff you approve, with a receipt naming what ran, where it ran, and
      what it cost.
    </p>

    <div data-animate class="mb-4" style="transition-delay: 200ms">
      <a
        href={flowLandingHref}
        rel="noopener"
        target="_blank"
        class="inline-flex items-center justify-center gap-2 font-mono text-xs tracking-[0.12em] uppercase bg-primary text-surface px-8 py-3 rounded-md hover:shadow-[0_0_0_4px_var(--color-primary-glow)] transition-shadow"
      >
        {FLOW_COPY.cta}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
      </a>
    </div>

    <p data-animate class="font-mono text-[0.66rem] tracking-wider text-text-dim" style="transition-delay: 240ms">
      {FLOW_COPY.fine}
    </p>

    <!-- The GitHub / Documentation / Field Notes outline trio was removed here.
         A closing CTA with four competing buttons has no CTA; this section now
         asks for exactly one thing. All three destinations remain reachable
         from the Footer's link grid and the nav. -->

    <!-- Terminal CTA -->
    <p data-animate class="font-mono text-[10px] tracking-[0.2em] uppercase text-text-muted mt-10 mb-2">
      Try the companion software
    </p>
    <div data-animate class="max-w-sm mx-auto">
      <div class="relative border border-primary/30 rounded-lg primary-pulse overflow-hidden">
        <div class="flex items-center justify-between px-4 py-2 border-b border-primary/10">
          <span class="font-mono text-[10px] uppercase tracking-widest text-text-muted">Terminal</span>
          <button
            id="footer-copy-btn"
            class="p-1 rounded text-text-muted/50 hover:text-text-muted transition-colors"
            aria-label="Copy to clipboard"
          >
            <svg id="footer-copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
            <svg id="footer-check-icon" class="hidden" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"/>
            </svg>
          </button>
        </div>
        <div class="bg-surface-raised px-4 py-3">
          <pre class="font-mono text-lg sm:text-xl leading-relaxed text-text-muted"><span class="text-primary">$</span> <code id="footer-code">npx ainative-business</code><span class="hero-cursor">▌</span></pre>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initFooterCopy() {
    document.getElementById('footer-copy-btn')?.addEventListener('click', async () => {
      const code = document.getElementById('footer-code')?.textContent ?? '';
      await navigator.clipboard.writeText(code);
      const copyIcon = document.getElementById('footer-copy-icon');
      const checkIcon = document.getElementById('footer-check-icon');
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
      }, 2000);
    });
  }

  initFooterCopy();
  document.addEventListener('astro:after-swap', initFooterCopy);
</script>
